# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# ── Site ──────────────────────────────────────────────────────────────────
# Public URL without trailing slash (used in emails, sitemap, canonical links).
NEXT_PUBLIC_SITE_URL=https://www.example.ee

# ── Supabase (Project Settings → API) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon" / publishable key — safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — server only, NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Graphite Auto <booking@example.ee>".
EMAIL_FROM="Graphite Auto <booking@example.ee>"
# Who gets admin notifications (comma separated). Can also be set in /admin → Settings.
NOTIFY_EMAILS=owner@example.ee,manager@example.ee

# ── Optional ──────────────────────────────────────────────────────────────
# Analytics load only after the visitor accepts cookies. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Salt for hashing visitor IPs in the rate limiter (any random string).
IP_HASH_SALT=
# Rate limits per IP per window (defaults: 5 bookings, 3 callbacks, 10 cancels / 600 s).
# RATE_LIMIT_BOOKINGS=5
# RATE_LIMIT_CALLBACKS=3
# RATE_LIMIT_CANCELS=10
# RATE_LIMIT_WINDOW_SECONDS=600
