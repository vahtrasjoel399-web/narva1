# Public site URL, no trailing slash (used in emails, sitemap, hreflang, OG)
NEXT_PUBLIC_SITE_URL=https://www.example.ee

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" key or the newer "publishable" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key or the newer "secret" key. SERVER ONLY, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com > API Keys). Sender must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM="Autoteenindus <broneering@example.ee>"
# Optional: where customer replies go
EMAIL_REPLY_TO=info@example.ee

# Admin notification recipients, comma separated. Can be overridden in /admin/settings.
NOTIFY_EMAILS=owner@example.ee,mechanic@example.ee

# Optional analytics. Loaded only after cookie consent. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Dev only: write emails to ./.outbox as HTML files instead of sending.
EMAIL_DEV_OUTBOX=0

# Search engine ownership codes (only the code, not the whole <meta> tag)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_VERIFICATION=
